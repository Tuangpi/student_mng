{
  "name": "@student-mng/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && tsc --noEmit && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/index.js",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "test": "prisma generate && vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "@types/supertest": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "@types/bcrypt": "^5.0.2",
    "vitest": "^5.0.5"
  }
}